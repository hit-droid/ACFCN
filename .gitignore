# Generated OpenCL ICD loader (built by scripts/setup-opencl-ndk.sh) — every ABI's
# build output stays ignored, EXCEPT the NDK-cross-compiled proot runtime, which
# is a source-level asset shipped in the APK (see specs/linux-container/).
app/src/main/jniLibs/*/*
!app/src/main/jniLibs/arm64-v8a/libproot.so
!app/src/main/jniLibs/arm64-v8a/libproot-loader.so
